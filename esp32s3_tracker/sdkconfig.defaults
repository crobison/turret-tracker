# ESP32-S3-WROOM-1 N16R8: 16 MB quad flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Speed (from Espressif's esp-dl example defaults for ESP32-S3)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Octal PSRAM (the "R8" in N16R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Camera frame buffers live in PSRAM
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768

# Model is baked into the firmware image (no SD card needed)
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_FLASH_PEDESTRIAN_DETECT_PICO_S8_V1=y

# Wi-Fi live view: keep Wi-Fi/lwIP buffers in PSRAM where possible so the
# camera and detector keep enough internal RAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Browsers can send long request headers; avoid "431 header too long" errors.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
